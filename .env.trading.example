# Self-Hosted Trading System - Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL (Main Application DB)
DB_USER=trader
DB_PASSWORD=change_this_secure_password_123
DB_NAME=trading_db

# TimescaleDB (Market Data)
TSDB_USER=trader
TSDB_PASSWORD=change_this_secure_password_456
TSDB_NAME=market_data

# Redis
REDIS_PASSWORD=redis_secure_password

# ==========================================
# MONITORING
# ==========================================

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_admin_password
GRAFANA_ROOT_URL=http://localhost:3000

# Grafana SMTP (for email alerts)
GF_SMTP_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com:587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS=your_app_specific_password

# ==========================================
# API KEYS (Free tiers only)
# ==========================================

# Polymarket (optional, mostly free)
POLYMARKET_API_KEY=

# CoinGecko (free tier: 10-30 calls/min)
COINGECKO_API_KEY=

# CoinMarketCap (free tier available)
COINMARKETCAP_API_KEY=

# OpenAI (optional, for news sentiment)
OPENAI_API_KEY=

# ==========================================
# BLOCKCHAIN RPC ENDPOINTS (Free public nodes)
# ==========================================

# Multiple endpoints for redundancy
ETH_RPC_URLS=https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://ethereum.publicnode.com,https://cloudflare-eth.com
POLYGON_RPC_URLS=https://polygon.llamarpc.com,https://rpc.ankr.com/polygon,https://polygon-rpc.com
ARBITRUM_RPC_URLS=https://arb1.arbitrum.io/rpc,https://rpc.ankr.com/arbitrum
OPTIMISM_RPC_URLS=https://mainnet.optimism.io,https://rpc.ankr.com/optimism
BASE_RPC_URLS=https://mainnet.base.org,https://base.llamarpc.com

# ==========================================
# TRADING PARAMETERS
# ==========================================

# Mode: paper (simulated) or live (real trades)
TRADING_MODE=paper

# Risk Limits
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=500
MAX_TOTAL_EXPOSURE_USD=5000

# Strategy Parameters
MIN_PROFIT_PERCENT=0.5
MIN_YIELD_THRESHOLD=10
MAX_SLIPPAGE_PERCENT=1.0

# ==========================================
# NOTIFICATIONS
# ==========================================

# Telegram (for alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=

# ==========================================
# SERVICE CONFIGURATION
# ==========================================

# News scraper interval (minutes)
SCRAPE_INTERVAL_MINUTES=5

# Whale tracker minimum threshold (ETH)
WHALE_THRESHOLD_ETH=100

# Log level: debug, info, warn, error
LOG_LEVEL=info
