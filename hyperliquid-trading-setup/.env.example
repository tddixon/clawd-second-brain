# Hyperliquid Testnet Configuration
# ⚠️ NEVER use mainnet private keys here!

# Your testnet wallet private key (from MetaMask/Rabby)
HYPERLIQUID_TESTNET_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY_HERE

# Testnet mode (always true for paper trading)
HYPERLIQUID_TESTNET=true

# Bot password (for Hummingbot encryption)
CONFIG_PASSWORD=a

# Optional: Chainstack RPC (faster, more reliable)
# CHAINSTACK_RPC=https://your-chainstack-endpoint.com
